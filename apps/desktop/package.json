{
  "name": "@lumina/desktop",
  "version": "0.0.1",
  "private": true,
  "description": "Lumina Electron + React NLE shell",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "vite",
    "dev:electron": "node electron/dev.mjs",
