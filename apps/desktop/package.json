    "preview": "vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "@lumina/ai": "0.0.1",
    "@lumina/core": "0.0.1",
    "@lumina/effects": "0.0.1",
    "@lumina/i18n": "0.0.1",
    "@lumina/media-client": "0.0.1",
    "@lumina/plugin-sdk": "0.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^33.2.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.5"
