{
  "name": "@lumina/ai",
  "version": "0.0.1",
  "description": "Optional AI module: Whisper STT hooks, scene detect, auto-reframe contracts",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
